@page "/register"
@implements IDisposable
@inject HttpClient Http

<PageTitle>Register | ReFrog</PageTitle>

<div class="registration-shell">
    <section class="registration-intro" aria-labelledby="registration-heading">
        <p class="eyebrow">ReFrog account</p>
        <h1 id="registration-heading">Create your account</h1>
        <p class="intro-copy">Register once to access ReFrog's protected volunteer, shopping, and account features.</p>

        <ol class="registration-progress" aria-label="Registration progress">
            <li class="@(form.Pending is null && form.Completed is null ? "current" : "complete")">
                <span aria-hidden="true">1</span>
                Account details
            </li>
            <li class="@(form.Pending is not null && form.Completed is null ? "current" : form.Completed is not null ? "complete" : "")">
                <span aria-hidden="true">2</span>
                Verify email
            </li>
        </ol>
    </section>

    <section class="registration-card" aria-label="Account registration">
        @if (form.Completed is not null)
        {
            <div class="success-panel" role="status">
                <div class="success-mark" aria-hidden="true">✓</div>
                <p class="eyebrow">Registration complete</p>
                <h2>Your account is ready</h2>
                <p>@form.Completed.Email</p>
                @if (form.Completed.TcuEmailVerified)
                {
                    <p class="verification-badge">TCU email verified</p>
                }
            </div>
        }
        else if (form.Pending is null)
        {
            <div class="card-heading">
                <h2>Start with your email</h2>
                <p>We'll send a one-time code to confirm that the address belongs to you.</p>
            </div>

            <form class="registration-form" @onsubmit="form.StartAsync" @onsubmit:preventDefault>
                <div class="field-group">
                    <label for="registration-email">Email address</label>
                    <input id="registration-email" type="email" autocomplete="email" @bind="form.Email"
                           aria-describedby="email-guidance" required />
                    <p id="email-guidance" class="field-help">Please use a tcu.edu email if you are a TCU affiliate.</p>
                    @if (form.FieldError("email") is { } emailError)
                    {
                        <p class="field-error" role="alert">@emailError</p>
                    }
                </div>

                <div class="field-group">
                    <label for="registration-password">Password</label>
                    <input id="registration-password" type="password" autocomplete="new-password" @bind="form.Password"
                           aria-describedby="password-guidance" required />
                    <p id="password-guidance" class="field-help">Use 6+ characters with uppercase, lowercase, a number, and a symbol.</p>
                    @if (form.FieldError("password") is { } passwordError)
                    {
                        <p class="field-error" role="alert">@passwordError</p>
                    }
                </div>

                <button class="primary-action" type="submit" disabled="@form.Busy">
                    @(form.Busy ? "Sending code…" : "Continue")
                </button>
            </form>
        }
        else
        {
            <div class="card-heading">
                <p class="eyebrow">Check your inbox</p>
                <h2>Verify your email</h2>
                <p>Enter the six-digit code sent to <strong>@form.Email</strong>.</p>
            </div>

            <form class="registration-form" @onsubmit="form.VerifyAsync" @onsubmit:preventDefault>
                <div class="field-group">
                    <label for="registration-code">Verification code</label>
                    <input class="code-input" id="registration-code" type="text" inputmode="numeric"
                           autocomplete="one-time-code" maxlength="6" pattern="[0-9]{6}" @bind="form.Code" required />
                    @if (form.FieldError("code") is { } codeError)
                    {
                        <p class="field-error" role="alert">@codeError</p>
                    }
                </div>

                <button class="primary-action" type="submit" disabled="@form.Busy">
                    @(form.Busy ? "Verifying…" : "Verify and create account")
                </button>
            </form>

            <div class="resend-panel">
                <p>Didn't receive the email?</p>
                <button class="secondary-action" type="button" disabled="@(form.Busy || !form.CanResend)"
                        @onclick="form.ResendAsync">Send a new code</button>
                @if (!form.CanResend)
                {
                    <p class="resend-time">Available after @ChicagoTime(form.Pending.ResendAvailableAt).</p>
                }
            </div>
        }

        @if (form.Error is not null)
        {
            <div class="form-alert" role="alert">
                <strong>We couldn't complete that request.</strong>
                <p>@form.Error.Message</p>
                @if (form.Error.RetryAt is not null)
                {
                    <p>Try again after @ChicagoTime(form.Error.RetryAt.Value).</p>
                }
            </div>
        }
    </section>
</div>

@code {
    private RegistrationForm form = null!;

    private CancellationTokenSource? resendTimer;

    protected override void OnInitialized() => form = new RegistrationForm(Http);

    // Re-render when the server's resend time passes so the button enables itself.
    protected override void OnAfterRender(bool firstRender)
    {
        if (resendTimer is null && form.Pending is not null && !form.CanResend)
        {
            resendTimer = new CancellationTokenSource();
            _ = RefreshWhenResendOpensAsync(form.ResendWait, resendTimer.Token);
        }
    }

    private async Task RefreshWhenResendOpensAsync(TimeSpan wait, CancellationToken token)
    {
        try
        {
            await Task.Delay(wait, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        resendTimer?.Dispose();
        resendTimer = null;
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        resendTimer?.Cancel();
        resendTimer?.Dispose();
    }

    private static string ChicagoTime(DateTimeOffset instant)
    {
        var chicago = TimeZoneInfo.FindSystemTimeZoneById("America/Chicago");
        var local = TimeZoneInfo.ConvertTime(instant, chicago);
        return local.ToString("MMM d, yyyy h:mm tt", System.Globalization.CultureInfo.InvariantCulture)
            .Replace("AM", "a.m.", StringComparison.Ordinal)
            .Replace("PM", "p.m.", StringComparison.Ordinal);
    }
}
