@page "/reset-password"
@inject RecoveryForm Form
@inject NavigationManager Navigation

<PageTitle>Reset password | ReFrog</PageTitle>

<RecoveryPanel Heading="Reset your password">
    @if (Form.PasswordChanged)
    {
        <p role="status">Your password has been changed.</p>
        <p><a href="sign-in">Sign in with your new password</a></p>
    }
    else if (!Form.HasResetLink || Form.Error?.Code == "RESET_TOKEN_INVALID")
    {
        <p role="alert">This reset link is invalid or has expired.</p>
        <p><a href="recover-account">Request a new recovery link</a></p>
    }
    else
    {
        <form @onsubmit="Form.ResetAsync" @onsubmit:preventDefault>
            <label for="reset-password">New password</label>
            <input id="reset-password" type="password" autocomplete="new-password" @bind="Form.NewPassword"
                   aria-describedby="reset-password-error" required />
            @if (Form.FieldError("newPassword") is { } passwordError)
            {
                <p id="reset-password-error" class="field-error" role="alert">@passwordError</p>
            }
            <button type="submit" disabled="@Form.Busy">@(Form.Busy ? "Saving password…" : "Reset password")</button>
        </form>

        @if (Form.Error is not null)
        {
            <p role="alert">@Form.Error.Message</p>
        }

        <p><a href="recover-account">Request a new recovery link</a></p>
        <p><a href="sign-in">Return to sign-in</a></p>
    }
</RecoveryPanel>

@code {
    protected override void OnInitialized()
    {
        var link = new Uri(Navigation.Uri);
        Form.LoadResetLink(link);
        if (!string.IsNullOrEmpty(link.Fragment))
        {
            Navigation.NavigateTo("reset-password", replace: true);
        }
    }
}
